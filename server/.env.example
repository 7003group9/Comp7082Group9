PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_claim
JWT_SECRET=change-me
STUDENT_EMAIL_DOMAIN=my.bcit.ca
# Empty = print login codes in the server console instead of emailing them.
# On the real server set NODE_ENV=production: SMTP_URL is then required.
# NODE_ENV=production
SMTP_URL=
MAIL_FROM=Campus Claim <no-reply@your-domain>
# Dev only: test accounts that log in with a fixed code (no email sent).
# Must be removed in production; the server refuses to start with it there.
# Off by default: uncomment in your own .env to use them.
# TEST_LOGINS=tester1@my.bcit.ca:111111,tester2@my.bcit.ca:222222,admin@my.bcit.ca:999999
